__pycache__/
*.pyc
.env
# Vite also reads .env.local during a production build. A tracked one puts
# VITE_DEV_AUTH=1 into the deployed bundle unless the host happens to define
# that exact key, which nothing would think to do — see apps/web/.env.example.
.env.local
.env.*.local
.venv/
node_modules/
dist/
.DS_Store

# Local agent and editor tooling — per-machine, not part of the project.
.agents/
.claude/
.superpowers/
.cmem-projects/
agent-transcripts/
skills-lock.json
.github/copilot-instructions.md
# The root has no package of its own; these belong to local tooling.
/package.json
/package-lock.json
