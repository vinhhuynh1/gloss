# Copy to .env for local development.
#
# `npm run dev` loads this file via node's built-in --env-file. `npm start`
# does NOT — production platforms inject real environment variables, and
# --env-file exits non-zero when the file is absent. server.js itself never
# reads a .env, so nothing here applies to a bare `node server.js`.

# node-postgres, so NO "+psycopg" prefix (unlike apps/api).
# Local: postgresql://study_notes:study_notes@localhost:5432/study_notes
# Supabase: the SESSION pooler host, port 5432 — see infra/README.md.
DATABASE_URL=postgresql://study_notes:study_notes@localhost:5432/study_notes

# Set when talking to a local Postgres that has no TLS.
PGSSL_DISABLE=1

# Project Settings -> API -> Project URL. Used to verify connection tokens.
SUPABASE_URL=

# Only for legacy projects still signing with the shared HS256 secret.
SUPABASE_JWT_SECRET=

# Port to bind. Injected by the platform in production.
PORT=1234

# How long after the last edit to write the document back to Postgres.
FLUSH_DEBOUNCE_MS=5000
