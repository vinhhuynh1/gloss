# Copy to .env and fill in.

# Local docker-compose:
#   postgresql+psycopg://study_notes:study_notes@localhost:5432/study_notes
# Supabase: use the SESSION pooler host (port 5432), not db.<ref>.supabase.co
# — the direct host is IPv6-only on the free tier and most platforms cannot
# reach it. See infra/README.md.
DATABASE_URL=postgresql+psycopg://study_notes:study_notes@localhost:5432/study_notes

# Project Settings -> API -> Project URL. Used to verify Supabase Auth JWTs
# against the project's JWKS endpoint.
SUPABASE_URL=

# Optional. Only for projects still signing with the legacy shared HS256
# secret; leave blank on projects created after May 2025, which use
# asymmetric keys and are verified via JWKS.
SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Shared secret the agent worker presents as X-Agent-Token when it POSTs
# suggestions. Must match AGENT_SERVICE_TOKEN in apps/agent-worker/.env.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SERVICE_TOKEN=
