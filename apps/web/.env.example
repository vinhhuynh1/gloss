# Copy to .env.local for development.
#
# These are compiled INTO the bundle at build time, not read at runtime — so
# a deployment needs them present as build variables, and none of them may
# hold a secret. The Supabase anon key is designed to be public; the database
# is protected by row-level security (infra/supabase/011_lockdown.sql), not by
# hiding this value.

# Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_API_BASE_URL=http://localhost:8000

# Must be wss:// wherever the page itself is served over https:// — browsers
# block plain ws:// from a secure page as mixed content.
VITE_WS_URL=ws://localhost:1234
