# Copy to .env and fill in your key. Note the URL has no "+psycopg" here —
# the worker uses psycopg directly rather than through SQLAlchemy.
#
# The worker stays LOCAL — it is not deployed, because sentence-transformers
# pulls in torch. Point DATABASE_URL and API_BASE_URL at the hosted values to
# run it against the deployed stack from your machine.
#
# Supabase: use the SESSION pooler host (port 5432), not db.<ref>.supabase.co.
# See infra/README.md.
DATABASE_URL=postgresql://study_notes:study_notes@localhost:5432/study_notes
API_BASE_URL=http://localhost:8000

# Only needed for the `python agent.py` CLI, which writes its suggestion
# through POST /suggestions. worker.py writes suggestions to the database
# directly and ignores this. Must match AGENT_SERVICE_TOKEN in apps/api/.env.
AGENT_SERVICE_TOKEN=

ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5 (see agent.py). Set it to compare models
# against eval/run_eval.py — the run record stores whichever was used, so two
# runs on different models stay tellable apart afterwards.
# ANTHROPIC_MODEL=claude-opus-5

# Optional, and only read by eval/run_eval.py --judge: holds the grading model
# fixed while ANTHROPIC_MODEL is swept. A judge that changes underneath the
# thing it is judging measures nothing.
# JUDGE_MODEL=claude-opus-5

# Optional convenience for the eval, which otherwise wants STUDY_SPACE_ID in
# the environment on every invocation. apps/agent-worker/seed_demo.py prints
# the uuid to use. Nothing else reads this.
# STUDY_SPACE_ID=
